{
  "name": "nutrition-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-бот «Виртуальный консультант по питанию» — monorepo (bot, api, shared, scheduler)",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/bot",
    "packages/scheduler"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && npm run clean --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/*.{ts,json}\" \"*.{json,mjs}\" \"tsconfig*.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"packages/**/*.{ts,json}\" \"*.{json,mjs}\" \"tsconfig*.json\" \".prettierrc.json\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  }
}
