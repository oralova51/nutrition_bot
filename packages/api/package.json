{
  "name": "@nutrition-bot/api",
  "version": "0.1.0",
  "private": true,
  "description": "Admin/Internal REST API (генерация ссылок, клиенты, health-check)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nutrition-bot/shared": "*",
    "@nutrition-bot/ai": "*"
  },
  "scripts": {
    "build": "tsc -b .",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  }
}
