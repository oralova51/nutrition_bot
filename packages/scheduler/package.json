{
  "name": "@nutrition-bot/scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Планировщик задач: напоминания, неактивность, завершение курсов",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nutrition-bot/shared": "*",
    "@nutrition-bot/ai": "*",
    "node-cron": "^3.0.3"
  },
  "scripts": {
    "build": "tsc -b .",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11"
  }
}
